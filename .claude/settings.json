{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "claude-opus-5[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get(\"tool_response\",{}).get(\"filePath\") or d.get(\"tool_input\",{}).get(\"file_path\") or \"\")'); case \"$fp\" in */frontend/*.ts|*/frontend/*.tsx) front=\"${fp%%/frontend/*}/frontend\"; (cd \"$front\" && npx --no-install eslint --fix \"$fp\"); ;; esac 2>/dev/null || true",
            "statusMessage": "eslint --fix on changed frontend file"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_relevant_tests.py\"",
            "timeout": 330,
            "statusMessage": "baseline de tests de la app afectada"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_relevant_tests.py\"",
            "timeout": 330,
            "statusMessage": "corriendo tests finales de las apps tocadas"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true
}
