# Every setting in `src/zzz_tracker/config.py`, with the `ZZZ_` prefix `pydantic-settings`
# expects. Copy to `.env` for local development; on Vercel these are project environment
# variables instead (see `docs/DEPLOY.md`). Anything left out falls back to the default
# shown here, so a local `.env` only needs the lines it actually changes.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Local development: a SQLite file. `data/` is created on first use.
ZZZ_DATABASE_URL=sqlite:///./data/zzz.db
# Hosted Postgres (Neon, Supabase, Vercel Postgres) looks like the line below. Use the
# *pooled* host the provider gives you (Neon spells it `-pooler`): the API runs as
# serverless functions and keeps no pool of its own. `postgres://` and `postgresql://`
# are both accepted — the driver is pinned to psycopg 3 on the way in.
# ZZZ_DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/zzz?sslmode=require

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Fernet key that encrypts the HoYoLAB cookies stored in `hoyolab_credentials`.
# Generate it with:  uv run zzz-tracker new-credentials-key
# Empty means no cipher: storing or reading credentials answers 422. Changing it makes
# every credential already stored unreadable.
ZZZ_CREDENTIALS_KEY=

# Optional bearer token for `POST /accounts/{uid}/chronicle/import`, the endpoint the
# browser extension calls. Empty leaves the endpoint open to whoever holds the account key
# (see `docs/OWNERSHIP.md`); set it to demand a `Bearer` on top of that key on your own
# deployment. It is not a secret once the extension ships with it, so it can never be the
# only defence. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ZZZ_API_TOKEN=

# ---------------------------------------------------------------------------
# Enka.Network — the public showcase import
# ---------------------------------------------------------------------------

# Where the store files that turn game ids into names and icons are read from.
# Refresh them with:  uv run zzz-tracker sync-static
# They are committed under `data/static/` so they ship with the deployment; Vercel's
# filesystem is read-only, so `sync-static` cannot run there.
ZZZ_STATIC_DATA_DIR=./data/static
ZZZ_ENKA_BASE_URL=https://enka.network/api/zzz

# ---------------------------------------------------------------------------
# HoYoLAB — the Battle Chronicle sync
# ---------------------------------------------------------------------------

ZZZ_HOYOLAB_BASE_URL=https://sg-act-public-api.hoyolab.com/event/game_record_zzz/api/zzz
# Language of the names HoYoLAB returns, and therefore of the ones persisted.
ZZZ_HOYOLAB_LANGUAGE=en-us
# Shortest gap between two syncs of the same account. `--force` overrides it; the cron
# must not.
ZZZ_HOYOLAB_SYNC_TTL_SECONDS=3600
# How long the tracker stops hitting HoYoLAB for an account after a rate limit or a
# captcha (see `docs/HOYOLAB.md`).
ZZZ_HOYOLAB_BACKOFF_SECONDS=900

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Title of the OpenAPI document.
ZZZ_APP_NAME=ZZZ Tracker
