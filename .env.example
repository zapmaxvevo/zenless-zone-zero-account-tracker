# Every setting in `src/zzz_tracker/config.py`, with the `ZZZ_` prefix `pydantic-settings`
# expects — the whole list, nothing else exists. Copy to `.env` for local development; on
# Vercel these are project environment variables instead (see `docs/DEPLOY.md`). Anything
# left out falls back to the default shown here, so a local `.env` only needs the lines it
# actually changes.
#
# There is no mandatory secret. The server never talks to HoYoLAB and stores no cookies:
# the Battle Chronicle arrives as a bundle the browser extension captured and posted, so
# the only thing that authorises a write is the account key (see `docs/OWNERSHIP.md`),
# which lives hashed in the database and never in this file.

# ---------------------------------------------------------------------------
# Database — the only setting a deployment really has to get right
# ---------------------------------------------------------------------------

# Local development: a SQLite file. `data/` is created on first use.
ZZZ_DATABASE_URL=sqlite:///./data/zzz.db
# Hosted Postgres (Neon, Supabase, Vercel Postgres) looks like the line below. Use the
# *pooled* host the provider gives you (Neon spells it `-pooler`): the API runs as
# serverless functions and keeps no pool of its own. `postgres://` and `postgresql://`
# are both accepted — the driver is pinned to psycopg 3 on the way in.
# ZZZ_DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/zzz?sslmode=require

# ---------------------------------------------------------------------------
# The optional gate on the extension's import
# ---------------------------------------------------------------------------

# Bearer token for `POST /accounts/{uid}/chronicle/import`, the endpoint the browser
# extension calls. Empty leaves that endpoint governed by the ownership rules alone: an
# import claims an account nobody owns, and against one that has an owner it demands that
# owner's key. Set it to demand a `Bearer` on top of those rules on your own deployment.
# It is not a secret once the extension ships with it, so it can never be the only defence.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ZZZ_API_TOKEN=

# ---------------------------------------------------------------------------
# Enka.Network — the public showcase import
# ---------------------------------------------------------------------------

# Where the store files that turn game ids into names and icons are read from.
# Refresh them with:  uv run zzz-tracker sync-static
# They are committed under `data/static/` so they ship with the deployment; Vercel's
# filesystem is read-only, so `sync-static` cannot run there. On Vercel this is left unset:
# `api/index.py` points it at the bundled copy by itself.
ZZZ_STATIC_DATA_DIR=./data/static

# Only worth overriding to aim at a mock.
ZZZ_ENKA_BASE_URL=https://enka.network/api/zzz

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Title of the OpenAPI document.
ZZZ_APP_NAME=ZZZ Tracker
